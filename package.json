{
  "name": "freeroam",
  "version": "1.0.0",
  "private": true,
  "description": "Freeroam: Express backend + Vue frontend, managed as one npm workspace.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "npm run build --workspace=frontend && npm start --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "dev": "npm run dev --workspace=frontend",
    "test": "npm test --workspace=backend"
  },
  "engines": {
    "node": ">=18"
  }
}
